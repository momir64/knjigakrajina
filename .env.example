# Public origin of the site (canonical links, sitemap, JSON-LD)
SITE_URL=http://localhost:5173

# Resend (https://resend.com) - leave the API key empty to only log emails to the console
RESEND_API_KEY=
MAIL_FROM=Књига Крајина <narudzbine@knjigakrajina.com>
# Only seeds the notification list of a brand-new database; afterwards it is edited in the back office
DEFAULT_NOTIFY_EMAILS=snjezana.stanisic.ns@gmail.com

# SQLite file and uploaded images (relative to the working directory)
DB_PATH=data/knjigakrajina.db
UPLOADS_DIR=uploads

# Hidden back office. Both must be set, otherwise it does not exist (every URL under it is a 404).
# ADMIN_PATH: secret URL prefix, one segment of up to 64 letters/digits/-/_ (any word works, a long random one is safest),
#   e.g. /office-7f3k9x2m4q - never linked or listed anywhere, so make it unguessable.
# ADMIN_PASSWORD_HASH: run `npm run admin:password` and paste the line it prints.
ADMIN_PATH=
ADMIN_PASSWORD_HASH=

# Production only (node build), see README "Deploying":
# cover uploads are up to 20 MB, the adapter's default request limit is 512K
BODY_SIZE_LIMIT=25M

# Behind a Cloudflare Tunnel (cloudflared), see README "Deploying". Leave these unset when the app is exposed directly:
# HOST=127.0.0.1                  # listen on this machine only, so nothing but the tunnel can reach the app
# PORT=3000
# PROTOCOL_HEADER=x-forwarded-proto # Cloudflare sets it to https
# ADDRESS_HEADER=cf-connecting-ip   # the real visitor address (login lock, order limits)
# HOST_HEADER is not needed: cloudflared passes the original Host header on
